<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Нажатие (обратная связь) -->
    <item android:state_pressed="true" android:drawable="@color/selected_item_pressed" />
    <!-- Активный элемент (текущий трек) -->
    <item android:state_activated="true" android:drawable="@color/selected_item_active" />
    <!-- Обычное состояние -->
    <item android:drawable="@android:color/transparent" />
</selector>